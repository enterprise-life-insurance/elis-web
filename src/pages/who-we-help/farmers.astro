---
import Layout from '../../layouts/Layout.astro';
import SegmentHero from '../../components/who-we-help/SegmentHero.astro';
import SegmentRisks from '../../components/who-we-help/SegmentRisks.astro';
import CalculatorTeaser from '../../components/tools/CalculatorTeaser.astro';
import FAQ from '../../components/ui/FAQ.astro';
import CTASection from '../../components/ui/CTASection.astro';
import InsureLineReferral from '../../components/ui/InsureLineReferral.astro';
import { segments } from '../../data/segments';
import { segmentDetails } from '../../data/segmentDetails';
import { safeFetchOne } from '../../lib/sanityFetch';
import { segmentDetailQuery, isValidSegmentPageData, type SegmentPageData } from '../../lib/queries';

const SLUG = 'farmers';
const fallback: SegmentPageData = {
	...segments.find((s) => s.slug === SLUG)!,
	...segmentDetails.find((d) => d.slug === SLUG)!,
};
const fetched = await safeFetchOne<SegmentPageData | null>(segmentDetailQuery, { slug: SLUG }, null);
const segment: SegmentPageData = isValidSegmentPageData(fetched) ? fetched : fallback;
---

<Layout title={segment.title} description={segment.description}>
	<SegmentHero title={segment.title} intro={segment.intro} />
	<SegmentRisks risks={segment.risks} />
	<CalculatorTeaser slugs={['buy-sell']} />
	<FAQ items={segment.faq} />
	<InsureLineReferral message="For property, equipment, and liability coverage, speak with our affiliated company, InsureLine Enterprise." />
	<CTASection title="Ready to talk about your operation?" />
</Layout>
