---
import Layout from '../../layouts/Layout.astro';
import AdvisorProfile from '../../components/about/AdvisorProfile.astro';
import { advisors } from '../../data/advisors';

const advisor = advisors.find((a) => a.slug === 'jay-bablani')!;
---

<Layout title={advisor.name} description={advisor.shortBio}>
	<AdvisorProfile advisor={advisor} />
</Layout>
