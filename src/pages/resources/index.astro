---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/ui/Button.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import ResourceBadge from '../../components/resources/ResourceBadge.astro';
import { urlFor } from '../../lib/sanityImage';
import { safeFetch } from '../../lib/sanityFetch';

interface ResourceListItem {
	title: string;
	slug: string;
	excerpt?: string;
	coverImage?: any;
	format: 'blog-post' | 'article' | 'guide';
	gated: boolean;
	tags?: { name: string; slug: string }[];
	publishDate: string;
}

const resources = await safeFetch<ResourceListItem[]>(
	`*[_type == "resource"] | order(publishDate desc) {
		title,
		"slug": slug.current,
		excerpt,
		coverImage,
		format,
		gated,
		"tags": tags[]->{ name, "slug": slug.current },
		publishDate,
	}`,
	{},
	[],
);
---

<Layout
	title="Resources"
	description="Guides, articles, and downloads to help you plan your coverage — from Enterprise Life's advisors."
>
	<section class="bg-enterprise-blue-500">
		<div class="mx-auto max-w-4xl px-6 py-24">
			<h1 data-reveal class="text-4xl leading-tight font-semibold text-white md:text-5xl">Resources</h1>
			<p data-reveal class="mt-6 max-w-2xl text-lg text-white/90">
				Guides, articles, and free downloads to help you think through your coverage — written by our advisors,
				not fabricated for SEO.
			</p>
		</div>
	</section>

	{
		resources.length === 0 ? (
			<EmptyState
				eyebrow="Coming Soon"
				title="No resources published yet."
				message="We're not going to fabricate articles or guides to fill this page. Check back soon — or talk to an advisor directly in the meantime."
				ctaLabel="Talk to an Advisor"
				ctaHref="/contact"
			/>
		) : (
			<section class="mx-auto max-w-7xl px-6 py-24">
				<div data-reveal class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
					{resources.map((resource) => (
						<a
							href={`/resources/${resource.slug}`}
							class="group flex flex-col overflow-hidden rounded-2xl border border-natural-grey-600 bg-white transition-shadow duration-300 hover:shadow-lg"
						>
							{resource.coverImage && (
								<div class="aspect-[4/3] w-full overflow-hidden bg-natural-grey-500">
									<img
										src={urlFor(resource.coverImage).width(600).height(450).url()}
										alt=""
										class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
									/>
								</div>
							)}
							<div class="flex flex-1 flex-col gap-3 p-6">
								<ResourceBadge format={resource.format} gated={resource.gated} />
								<h3 class="text-lg font-semibold text-natural-grey-900">{resource.title}</h3>
								{resource.excerpt && <p class="text-sm text-natural-grey-800">{resource.excerpt}</p>}
								{resource.tags && resource.tags.length > 0 && (
									<div class="mt-auto flex flex-wrap gap-2 pt-2">
										{resource.tags.map((tag) => (
											<span class="rounded-full bg-natural-grey-500 px-2.5 py-1 text-xs text-natural-grey-800">
												{tag.name}
											</span>
										))}
									</div>
								)}
							</div>
						</a>
					))}
				</div>
			</section>
		)
	}

	<section class="bg-enterprise-blue-900">
		<div data-reveal class="mx-auto flex max-w-4xl flex-col items-center gap-6 px-6 py-20 text-center">
			<h2 class="text-3xl font-semibold text-white md:text-4xl">Want a plan built around your situation?</h2>
			<Button href="/contact">Talk to an Advisor</Button>
		</div>
	</section>
</Layout>
