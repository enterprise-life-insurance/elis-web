---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/services/ServiceHero.astro';
import CoverageOverview from '../../components/services/CoverageOverview.astro';
import FAQ from '../../components/ui/FAQ.astro';
import CTASection from '../../components/ui/CTASection.astro';
import { services } from '../../data/services';
import { serviceDetails } from '../../data/serviceDetails';

const service = services.find((s) => s.slug === 'disability-insurance')!;
const detail = serviceDetails.find((d) => d.slug === 'disability-insurance')!;
---

<Layout title={service.title} description={service.description}>
	<ServiceHero title={service.title} intro={detail.intro} />
	<CoverageOverview points={detail.coverageOverview} />
	<FAQ items={detail.faq} />
	<CTASection title="Ready to talk about your coverage?" />
</Layout>
