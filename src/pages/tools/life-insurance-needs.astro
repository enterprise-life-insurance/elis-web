---
import Layout from '../../layouts/Layout.astro';
import ToolHero from '../../components/tools/ToolHero.astro';
import NeedsCalculator from '../../components/tools/NeedsCalculator.tsx';
import CTASection from '../../components/ui/CTASection.astro';
---

<Layout
	title="Life Insurance Needs Calculator"
	description="Estimate how much life insurance your family would need, and how much you already have in place."
>
	<ToolHero
		title="How much life insurance does your family need?"
		intro="Add up what your family would have to pay for, then subtract what's already in place. The difference is the coverage to consider."
	/>
	<section class="mx-auto max-w-6xl px-6 py-16 md:py-24">
		<NeedsCalculator client:visible />
	</section>
	<CTASection title="Want a second set of eyes on your numbers?" />
</Layout>
