---
import Layout from '../../layouts/Layout.astro';
import ToolHero from '../../components/tools/ToolHero.astro';
import CTASection from '../../components/ui/CTASection.astro';
import { tools } from '../../data/tools';
---

<Layout title="Tools & Calculators" description="Get a clearer picture of your coverage before you talk to an advisor.">
	<ToolHero
		back={false}
		title="Tools & Calculators"
		intro="Get a clearer picture of your coverage before you talk to an advisor. Each tool gives a quick estimate using your own numbers — nothing you enter is stored or sent anywhere."
	/>

	<section class="mx-auto max-w-7xl px-6 py-24">
		<div class="grid gap-6 md:grid-cols-3">
			{
				tools.map((t) => (
					<a
						href={`/tools/${t.slug}`}
						data-reveal
						class="group flex flex-col gap-2 rounded-2xl border border-natural-grey-600 bg-white p-6 transition-shadow duration-300 hover:shadow-lg"
					>
						<span class="text-sm font-semibold tracking-wide text-life-green-600 uppercase">{t.audience}</span>
						<h2 class="text-lg font-semibold text-natural-grey-900">{t.title}</h2>
						<p class="text-sm text-natural-grey-800">{t.description}</p>
						<span class="mt-auto pt-2 text-sm font-semibold text-enterprise-blue-500 transition-colors duration-300 group-hover:text-enterprise-blue-600">
							Open calculator →
						</span>
					</a>
				))
			}
		</div>
		<p class="mt-10 max-w-3xl text-sm text-natural-grey-800">
			These calculators give general estimates for Ontario residents and are not financial, tax or legal advice. Talk to a licensed advisor
			before making decisions.
		</p>
	</section>

	<CTASection title="Prefer to walk through it together?" />
</Layout>
