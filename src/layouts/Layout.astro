---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description?: string;
	image?: string;
}

const {
	title,
	description = 'Enterprise Life Insurance and Investment Solutions',
	image = '/og-image.png',
} = Astro.props;

const pageTitle = `${title} | Enterprise Life`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
const isDefaultImage = image === '/og-image.png';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonicalURL} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{pageTitle}</title>

		<meta property="og:type" content="website" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />
		{isDefaultImage && <meta property="og:image:width" content="1200" />}
		{isDefaultImage && <meta property="og:image:height" content="630" />}
		<meta property="og:site_name" content="Enterprise Life" />
		<meta property="og:locale" content="en_CA" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />
		<script is:inline>
			// Added before paint so [data-reveal] only starts hidden when JS can actually
			// animate it in — no-JS visitors always see full content, no FOUC either way.
			document.documentElement.classList.add('js');
		</script>
	</head>
	<body class="flex min-h-screen flex-col bg-white font-sans text-natural-grey-900 antialiased">
		<Header />
		<div class="flex-1">
			<slot />
		</div>
		<Footer />
		<script src="../scripts/motion.ts"></script>
	</body>
</html>
