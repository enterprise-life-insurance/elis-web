---
import { Picture } from 'astro:assets';
import Button from '../ui/Button.astro';
import family from '../../assets/about/family.jpg';
import engineer from '../../assets/about/engineer.jpg';
import businessOwner from '../../assets/about/business-owner.jpg';
import healthcare from '../../assets/about/healthcare.jpg';

// Body copy is verbatim from brand/Enterprise Life – Visual Identity Guideline – Draft.pdf
// ("Brand Overview" slide) — confirmed brand voice, not written here. Grid photos are free-licence
// Unsplash stock, approved 2026-10-02: one per Who We Help segment, showing clients' lives rather
// than stand-ins for the ELIS team/office (real headshots appear further down the page).
// Sources: 20YP7NENJzk (CDC), _wNiWrINqoU (NordWood Themes), Pvaaeer8kws (Vitaly Gariev),
// TB8eQjc3_WE (Colynary Media) — unsplash.com/photos/<id>.
const photoClass = 'aspect-[4/3] w-full rounded-2xl object-cover';
const photoSizes = '(min-width: 768px) 33vw, 100vw';
const photoWidths = [480, 800, 1200];
---

<section class="bg-enterprise-blue-500">
	<div class="mx-auto max-w-4xl px-6 py-24">
		<p data-reveal class="mb-3 text-sm font-semibold tracking-wide text-life-green-300 uppercase">
			A New Company, Not New Advisors
		</p>
		<h1 data-reveal class="text-4xl leading-tight font-semibold text-white md:text-5xl">
			Protecting what you've spent years building.
		</h1>
		<div data-reveal class="mt-8">
			<Button href="/contact">Talk to an Advisor</Button>
		</div>
	</div>
</section>

<section class="mx-auto max-w-7xl px-6 py-24">
	<div data-reveal class="grid grid-cols-1 gap-4 md:grid-cols-3 md:grid-rows-2">
		<Picture
			src={family}
			alt="A father and his young daughter washing their hands together at a kitchen sink"
			formats={['avif', 'webp']}
			widths={photoWidths}
			sizes={photoSizes}
			class={photoClass}
			pictureAttributes={{ class: 'md:col-start-1 md:row-start-1' }}
		/>

		<div
			class="flex h-full items-center rounded-2xl bg-enterprise-blue-900 p-8 md:col-start-2 md:row-span-2 md:row-start-1"
		>
			<p class="text-base font-semibold text-white md:text-lg">
				Enterprise Life is a specialized insurance and investment practice built on advisors with decades of
				hands-on experience writing, managing, and tailoring policies to real people's lives.
			</p>
		</div>

		<Picture
			src={engineer}
			alt="An engineer holding a hard hat while reading plans beside a bright window"
			formats={['avif', 'webp']}
			widths={photoWidths}
			sizes={photoSizes}
			class={photoClass}
			pictureAttributes={{ class: 'md:col-start-3 md:row-start-1' }}
		/>
		<Picture
			src={businessOwner}
			alt="A clothing store owner checking inventory on a tablet beside a rack of garments"
			formats={['avif', 'webp']}
			widths={photoWidths}
			sizes={photoSizes}
			class={photoClass}
			pictureAttributes={{ class: 'md:col-start-1 md:row-start-2' }}
		/>
		<Picture
			src={healthcare}
			alt="A clinician in a white coat holding an X-ray up to the light by a window"
			formats={['avif', 'webp']}
			widths={photoWidths}
			sizes={photoSizes}
			class={photoClass}
			pictureAttributes={{ class: 'md:col-start-3 md:row-start-2' }}
		/>
	</div>
</section>

<section class="mx-auto max-w-7xl px-6 pb-24">
	<div data-reveal class="grid grid-cols-1 gap-8 md:grid-cols-2">
		<p class="text-natural-grey-700">
			The brand voice is grounded in understated confidence, precise and segment-fluent language, and a
			commitment to plain, honest explanations that close the gap between what people think their insurance
			covers and what it actually does.
		</p>
		<p class="text-natural-grey-700">
			At its core, ELIS exists to make expert-level insurance advice accessible and human, earning trust
			through clarity, experience, and a consistent focus on the lives clients have worked hard to build.
		</p>
	</div>
</section>
