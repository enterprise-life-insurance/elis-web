---
import QRCode from 'qrcode';
import CTASection from '../ui/CTASection.astro';
import type { Advisor } from '../../data/advisors';

interface Props {
	advisor: Advisor;
}

const { advisor } = Astro.props;

// IA calls for each advisor profile page to have its own QR code (ia/website-ia-sitemap.md).
// Generated at build time against the confirmed production domain.
const profileUrl = `https://enterpriselife.ca/about/${advisor.slug}`;
const qrSvg = await QRCode.toString(profileUrl, {
	type: 'svg',
	margin: 1,
	color: { dark: '#002946', light: '#00000000' },
});
---

<main>
	<div class="mx-auto max-w-4xl px-6 pt-10">
		<a href="/about" class="mb-8 inline-block text-sm font-semibold text-enterprise-blue-500 hover:text-enterprise-blue-600">
			← Back to About
		</a>
	</div>

	<section class="bg-enterprise-blue-900">
		<div class="mx-auto flex max-w-4xl flex-col gap-8 px-6 py-14 md:flex-row md:items-center">
			<img
				src={advisor.image}
				alt={advisor.name}
				class="h-32 w-32 shrink-0 rounded-full border-2 border-white/15 object-cover md:h-36 md:w-36"
			/>
			<div>
				<h1 class="text-3xl font-semibold text-white">{advisor.name}</h1>
				{advisor.role && <p class="mt-1 font-semibold text-life-green-300">{advisor.role}</p>}
				<div class="mt-4 flex flex-wrap gap-2">
					{
						advisor.tags.map((tag) => (
							<span class="rounded-full bg-white/10 px-3.5 py-1.5 text-sm font-semibold text-white/90">{tag}</span>
						))
					}
				</div>
			</div>
		</div>
	</section>

	<div class="mx-auto flex max-w-4xl flex-col gap-10 px-6 py-14 md:flex-row md:items-start">
		<div class="flex-1">
			<h2 class="mb-4 text-2xl font-semibold text-natural-grey-900">About {advisor.name.split(' ')[0]}</h2>
			<div class="flex flex-col gap-4 text-natural-grey-800">
				{advisor.bio.map((paragraph) => <p>{paragraph}</p>)}
			</div>
		</div>

		<div class="flex shrink-0 flex-col items-center gap-2 self-start rounded-2xl border border-natural-grey-600 p-4">
			<div class="h-28 w-28 [&>svg]:h-full [&>svg]:w-full">
				<Fragment set:html={qrSvg} />
			</div>
			<p class="text-xs text-natural-grey-800">Scan for this profile</p>
		</div>
	</div>

	<div class="mx-auto max-w-4xl px-6 pb-20">
		<h2 class="mb-6 text-2xl font-semibold text-natural-grey-900">Areas of Focus</h2>
		<div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
			{
				advisor.areasOfFocus.map((area) => (
					<div class="rounded-2xl border border-natural-grey-600 p-6">
						<h3 class="mb-2 font-semibold text-natural-grey-900">{area.title}</h3>
						<p class="text-sm text-natural-grey-800">{area.description}</p>
					</div>
				))
			}
		</div>
	</div>

	<CTASection
		title={`Speak with ${advisor.name.split(' ')[0]} about your coverage`}
		buttonLabel="Contact Us"
		buttonHref="/contact"
	/>
</main>
