---
interface Props {
	title: string;
	note?: string;
}

const { title, note } = Astro.props;
---

<main class="mx-auto flex min-h-screen max-w-2xl flex-col items-start justify-center gap-4 px-6 py-24">
	<p class="text-sm font-medium tracking-wide text-enterprise-blue-500 uppercase">Enterprise Life</p>
	<h1 class="text-4xl font-semibold text-natural-grey-900">{title}</h1>
	<p class="text-natural-grey-800">
		Route scaffolded from <code class="rounded bg-natural-grey-500 px-1.5 py-0.5">ia/website-ia-sitemap.md</code>. Content pending.
	</p>
	{note && <p class="text-natural-grey-800">{note}</p>}
</main>
