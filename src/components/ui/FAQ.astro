---
// Native <details>/<summary> accordion — accessible and works with zero JS.
export interface FAQItem {
	question: string;
	answer: string;
}

interface Props {
	items: FAQItem[];
	title?: string;
}

const { items, title = 'Frequently Asked Questions' } = Astro.props;
---

<section class="mx-auto max-w-3xl px-6 py-24">
	<h2 data-reveal class="mb-8 text-3xl font-semibold text-natural-grey-900">{title}</h2>
	<div data-reveal class="flex flex-col divide-y divide-natural-grey-600 border-y border-natural-grey-600">
		{
			items.map((item) => (
				<details class="group py-5">
					<summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-natural-grey-900 marker:content-none">
						{item.question}
						<span class="shrink-0 text-xl text-enterprise-blue-500 transition-transform duration-300 group-open:rotate-45">
							+
						</span>
					</summary>
					<p class="mt-3 text-natural-grey-800">{item.answer}</p>
				</details>
			))
		}
	</div>
</section>
