---
// Enterprise Life sells life, disability, and health products only. Property,
// liability, auto, and commercial coverage sit with InsureLine — this cross-referral
// is what the client's "Website notes.docx" asked for in place of promising P&C
// coverage on ELIS pages.
import { insureLine } from '../../data/site';

interface Props {
	message?: string;
}

const {
	message = 'Property, equipment, liability, and auto coverage are handled by our affiliated company, InsureLine Enterprise.',
} = Astro.props;
---

<section class="mx-auto max-w-4xl px-6 pb-12">
	<div data-reveal class="flex flex-col gap-4 rounded-2xl border border-natural-grey-600 p-6 md:flex-row md:items-center md:justify-between">
		<div>
			<p class="mb-1 text-sm font-semibold tracking-wide text-life-green-600 uppercase">Need property or liability coverage?</p>
			<p class="text-natural-grey-800">{message}</p>
		</div>
		<a
			href={insureLine.url}
			target="_blank"
			rel="noopener"
			class="shrink-0 text-sm font-semibold text-enterprise-blue-500 transition-colors duration-300 hover:text-enterprise-blue-600"
		>
			Visit {insureLine.shortName} ↗
		</a>
	</div>
</section>
