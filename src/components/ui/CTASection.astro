---
import Button from './Button.astro';

interface Props {
	title: string;
	buttonLabel?: string;
	buttonHref?: string;
}

const { title, buttonLabel = 'Talk to an Advisor', buttonHref = '/contact' } = Astro.props;
---

<section class="bg-enterprise-blue-900">
	<div data-reveal class="mx-auto flex max-w-4xl flex-col items-center gap-6 px-6 py-20 text-center">
		<h2 class="text-3xl font-semibold text-white md:text-4xl">{title}</h2>
		<Button href={buttonHref}>{buttonLabel}</Button>
	</div>
</section>
