---
import Card from '../ui/Card.astro';
import { segments } from '../../data/segments';
---

<section class="mx-auto max-w-7xl px-6 py-24">
	<div data-reveal class="mb-12 max-w-2xl">
		<p class="mb-3 text-sm font-semibold tracking-wide text-life-green-600 uppercase">Who We Help</p>
		<h2 class="text-3xl font-semibold text-natural-grey-900 md:text-4xl">
			Every client's risk looks different. Here's how we think about yours.
		</h2>
	</div>

	<div data-reveal class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
		{
			segments.map((segment) => (
				<Card href={`/who-we-help/${segment.slug}`} title={segment.title} description={segment.description} />
			))
		}
	</div>
</section>
