---
import Button from '../ui/Button.astro';
---

<section class="mx-auto max-w-7xl px-6 py-24">
	<div data-reveal class="flex flex-col items-start gap-6 rounded-3xl bg-life-green-50 p-10 md:flex-row md:items-center md:justify-between md:p-16">
		<div class="max-w-xl">
			<p class="mb-3 text-sm font-semibold tracking-wide text-life-green-600 uppercase">Tools & Calculators</p>
			<h2 class="text-3xl font-semibold text-natural-grey-900 md:text-4xl">
				Get a clearer picture of your coverage before you talk to an advisor.
			</h2>
		</div>
		<Button href="/tools">Explore Tools</Button>
	</div>
</section>
