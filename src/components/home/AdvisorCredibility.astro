---
// ⚠️ Glenn Merkley is not licensed for life insurance sales/servicing (see
// CLAUDE.md / ia/website-ia-sitemap.md). His copy stays scoped to commercial
// insurance for business owners, professionals, and HNW clients — now editable in
// Sanity Studio too, so that constraint is enforced editorially, not by code.
import { advisors as staticAdvisors } from '../../data/advisors';
import { safeFetchList } from '../../lib/sanityFetch';
import { advisorListQuery, isValidAdvisorCardData, type AdvisorCardData } from '../../lib/queries';

const fetchedAdvisors = await safeFetchList<AdvisorCardData>(advisorListQuery, {}, staticAdvisors, isValidAdvisorCardData);
const advisors = fetchedAdvisors.map((advisor) => {
	const staticMatch = staticAdvisors.find((a) => a.slug === advisor.slug);
	const role = staticMatch?.homeRole ?? advisor.role;
	return {
		slug: advisor.slug,
		name: advisor.name,
		detail: role ? `${role} — ${advisor.shortBio}` : advisor.shortBio,
		image: staticMatch?.image ?? '',
	};
});
---

<section class="bg-enterprise-blue-900">
	<div class="mx-auto max-w-7xl px-6 py-24">
		<div data-reveal class="mb-12 max-w-2xl">
			<p class="mb-3 text-sm font-semibold tracking-wide text-life-green-300 uppercase">A New Company, Not New Advisors</p>
			<h2 class="text-3xl font-semibold text-white md:text-4xl">Decades of experience, brought into one place.</h2>
		</div>

		<div data-reveal class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
			{
				advisors.map((advisor) => (
					<a
						href={`/about/${advisor.slug}`}
						class="group flex items-center gap-5 rounded-2xl bg-white/5 p-6 transition-colors duration-300 hover:bg-white/10"
					>
						<img
							src={advisor.image}
							alt={advisor.name}
							class="h-20 w-20 shrink-0 rounded-full object-cover"
						/>
						<div>
							<p class="text-lg font-semibold text-white">{advisor.name}</p>
							<p class="text-sm text-white/80">{advisor.detail}</p>
							<span class="mt-2 inline-block text-sm font-semibold text-life-green-300 group-hover:text-life-green-200">
								View profile →
							</span>
						</div>
					</a>
				))
			}
		</div>
	</div>
</section>
