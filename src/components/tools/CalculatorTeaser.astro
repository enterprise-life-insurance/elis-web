---
import { tools, type Tool } from '../../data/tools';

interface Props {
	slugs: Tool['slug'][];
}

const { slugs } = Astro.props;
const linked = slugs.map((slug) => tools.find((t) => t.slug === slug)!);
---

<section class="mx-auto max-w-4xl px-6 py-12">
	<div data-reveal class="rounded-3xl bg-life-green-50 p-8 md:p-10">
		<p class="mb-3 text-sm font-semibold tracking-wide text-life-green-600 uppercase">{linked.length > 1 ? 'Calculators' : 'Calculator'}</p>
		<h2 class="text-2xl font-semibold text-natural-grey-900">Run the numbers before you talk to an advisor.</h2>
		<div class:list={['mt-6 grid gap-4', linked.length > 1 && 'md:grid-cols-2']}>
			{
				linked.map((t) => (
					<a
						href={`/tools/${t.slug}`}
						class="group flex flex-col gap-2 rounded-2xl border border-natural-grey-600 bg-white p-6 transition-shadow duration-300 hover:shadow-lg"
					>
						<h3 class="text-lg font-semibold text-natural-grey-900">{t.title}</h3>
						<p class="text-sm text-natural-grey-800">{t.description}</p>
						<span class="mt-auto pt-2 text-sm font-semibold text-enterprise-blue-500 transition-colors duration-300 group-hover:text-enterprise-blue-600">
							Open calculator →
						</span>
					</a>
				))
			}
		</div>
	</div>
</section>
