# Create a Sanity project (sanity.io/manage or `npx sanity init`) and fill these in.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2026-08-07

# Write token for scripts/seed-sanity.ts (pnpm seed) — sanity.io/manage -> API ->
# Tokens -> Add API token, "Editor" permission. Not needed for normal dev/build.
SANITY_API_WRITE_TOKEN=

# SendGrid — contact form delivery (src/pages/api/contact.ts). Without these three
# set, the endpoint fails loudly with a 503 rather than silently pretending to send.
SENDGRID_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
